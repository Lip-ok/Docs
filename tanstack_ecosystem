⚡ Урок: TanStack Ecosystem (Query + Table + Router + Virtual)
🚀 1. Установка
npm install @tanstack/react-query
npm install @tanstack/react-table
npm install @tanstack/react-router
npm install @tanstack/react-virtual
🧠 2. Что такое TanStack

TanStack — это экосистема headless-библиотек для построения масштабируемых React-приложений.

Главная идея:

Логика отдельно — UI отдельно.

Ты получаешь мощную бизнес-логику, но полностью контролируешь разметку и стили.

🔥 3. TanStack Query — работа с серверным состоянием

Решает проблемы:

Кеширование

Повторные запросы

Фоновое обновление

Инвалидация

Мутации

Pagination / Infinite Scroll

📦 Базовая настройка
// main.tsx
import { QueryClient, QueryClientProvider } from '@tanstack/react-query'

const queryClient = new QueryClient()

root.render(
  <QueryClientProvider client={queryClient}>
    <App />
  </QueryClientProvider>
)
📥 Пример useQuery
import { useQuery } from '@tanstack/react-query'

function Users() {
  const { data, isLoading, error } = useQuery({
    queryKey: ['users'],
    queryFn: () => fetch('/api/users').then(res => res.json()),
  })

  if (isLoading) return <p>Loading...</p>
  if (error) return <p>Error</p>

  return (
    <ul>
      {data.map(user => (
        <li key={user.id}>{user.name}</li>
      ))}
    </ul>
  )
}
✍️ Пример useMutation
import { useMutation, useQueryClient } from '@tanstack/react-query'

function AddUser() {
  const queryClient = useQueryClient()

  const mutation = useMutation({
    mutationFn: (newUser) =>
      fetch('/api/users', {
        method: 'POST',
        body: JSON.stringify(newUser),
      }),
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: ['users'] })
    },
  })

  return (
    <button onClick={() => mutation.mutate({ name: 'John' })}>
      Add user
    </button>
  )
}
📊 4. TanStack Table — мощные таблицы

Headless-таблица для сложных интерфейсов.

📋 Базовый пример
import {
  createColumnHelper,
  useReactTable,
  getCoreRowModel,
} from '@tanstack/react-table'

const columnHelper = createColumnHelper()

const columns = [
  columnHelper.accessor('firstName', {
    header: 'First Name',
  }),
  columnHelper.accessor('age', {
    header: 'Age',
  }),
]

function Table({ data }) {
  const table = useReactTable({
    data,
    columns,
    getCoreRowModel: getCoreRowModel(),
  })

  return (
    <table>
      <thead>
        {table.getHeaderGroups().map(headerGroup => (
          <tr key={headerGroup.id}>
            {headerGroup.headers.map(header => (
              <th key={header.id}>
                {header.column.columnDef.header}
              </th>
            ))}
          </tr>
        ))}
      </thead>

      <tbody>
        {table.getRowModel().rows.map(row => (
          <tr key={row.id}>
            {row.getVisibleCells().map(cell => (
              <td key={cell.id}>{cell.getValue()}</td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  )
}
🛣 5. TanStack Router — типобезопасный роутинг

Современная альтернатива React Router с отличной типизацией.

Минимальный пример
import {
  createRouter,
  RouterProvider,
  Route,
  RootRoute,
  Outlet,
} from '@tanstack/react-router'

const rootRoute = new RootRoute({
  component: () => (
    <div>
      <Outlet />
    </div>
  ),
})

const indexRoute = new Route({
  getParentRoute: () => rootRoute,
  path: '/',
  component: () => <h1>Home</h1>,
})

const routeTree = rootRoute.addChildren([indexRoute])

const router = createRouter({ routeTree })

function App() {
  return <RouterProvider router={router} />
}
⚡ 6. TanStack Virtual — оптимизация производительности

Используется для больших списков и таблиц.

Пример виртуализации
import { useVirtualizer } from '@tanstack/react-virtual'
import React from 'react'

function List({ items }) {
  const parentRef = React.useRef(null)

  const rowVirtualizer = useVirtualizer({
    count: items.length,
    getScrollElement: () => parentRef.current,
    estimateSize: () => 40,
  })

  return (
    <div ref={parentRef} style={{ height: 400, overflow: 'auto' }}>
      <div
        style={{
          height: `${rowVirtualizer.getTotalSize()}px`,
          position: 'relative',
        }}
      >
        {rowVirtualizer.getVirtualItems().map(virtualRow => (
          <div
            key={virtualRow.key}
            style={{
              position: 'absolute',
              transform: `translateY(${virtualRow.start}px)`,
            }}
          >
            {items[virtualRow.index]}
          </div>
        ))}
      </div>
    </div>
  )
}
🧩 7. Как всё работает вместе

Типичная архитектура:

Router → управляет страницами

Query → загружает данные

Table → отображает данные

Virtual → оптимизирует рендер

🏁 Итог

TanStack — это набор инструментов для построения серьёзных SPA без Redux и лишнего бойлерплейта.

Если хочешь писать архитектурно чистый код — изучай TanStack.
